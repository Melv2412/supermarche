from io import BytesIO
from django.http import HttpResponse
from django.template.loader import get_template
from xhtml2pdf import pisa
from datetime import datetime, timedelta
from django.db.models import Sum, Count, Avg
from sales.models import Transaction, TransactionLine
from products.models import Product, Category, Promotion
from employees.models import Employee, Schedule
from customers.models import Customer, Complaint
from suppliers.models import Supplier, Order
from inventory.models import Stock

def render_to_pdf(template_src, context_dict={}):
    template = get_template(template_src)
    html = template.render(context_dict)
    result = BytesIO()
    pdf = pisa.pisaDocument(BytesIO(html.encode("UTF-8")), result)
    if not pdf.err:
        return HttpResponse(result.getvalue(), content_type='application/pdf')
    return None

# Rapports Admin
def generate_financial_report(start_date=None, end_date=None):
    if not start_date:
        start_date = datetime.now() - timedelta(days=30)
    if not end_date:
        end_date = datetime.now()
    
    sales = Sale.objects.filter(date__range=[start_date, end_date])
    total_revenue = sales.aggregate(Sum('total_amount'))['total_amount__sum'] or 0
    products_sold = SaleItem.objects.filter(sale__in=sales).count()
    
    context = {
        'start_date': start_date,
        'end_date': end_date,
        'total_revenue': total_revenue,
        'products_sold': products_sold,
        'average_sale': total_revenue / sales.count() if sales.count() > 0 else 0,
        'generated_at': datetime.now(),
    }
    return render_to_pdf('reporting/financial_report.html', context)

def generate_inventory_report():
    low_stock_products = Stock.objects.filter(quantity__lte=10)
    categories = Category.objects.all()
    
    context = {
        'low_stock_products': low_stock_products,
        'categories': categories,
        'total_products': Product.objects.count(),
        'generated_at': datetime.now(),
    }
    return render_to_pdf('reporting/inventory_report.html', context)

# Rapports RH
def generate_employee_schedule_report(start_date=None):
    if not start_date:
        start_date = datetime.now()
    
    schedules = Schedule.objects.filter(date=start_date)
    employees = Employee.objects.all()
    
    context = {
        'date': start_date,
        'schedules': schedules,
        'employees': employees,
        'generated_at': datetime.now(),
    }
    return render_to_pdf('reporting/schedule_report.html', context)

# Rapports Caissier
def generate_daily_sales_report(employee, date=None):
    if not date:
        date = datetime.now()
    
    sales = Sale.objects.filter(
        cashier=employee,
        date__date=date
    )
    
    context = {
        'employee': employee,
        'date': date,
        'sales': sales,
        'total_sales': sales.count(),
        'total_amount': sales.aggregate(Sum('total_amount'))['total_amount__sum'] or 0,
        'generated_at': datetime.now(),
    }
    return render_to_pdf('reporting/daily_sales_report.html', context)

# Rapports Client
def generate_customer_purchase_history(customer, start_date=None, end_date=None):
    if not start_date:
        start_date = datetime.now() - timedelta(days=90)
    if not end_date:
        end_date = datetime.now()
    
    purchases = Sale.objects.filter(
        customer=customer,
        date__range=[start_date, end_date]
    )
    
    context = {
        'customer': customer,
        'start_date': start_date,
        'end_date': end_date,
        'purchases': purchases,
        'total_spent': purchases.aggregate(Sum('total_amount'))['total_amount__sum'] or 0,
        'generated_at': datetime.now(),
    }
    return render_to_pdf('reporting/customer_history_report.html', context)