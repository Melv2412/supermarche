<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arborescence - Système Supermarché</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }
        
        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }
        
        .header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }
        
        .priority-levels {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        
        .priority-card {
            background: white;
            padding: 15px 25px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            text-align: center;
            min-width: 200px;
        }
        
        .priority-urgent { border-left: 5px solid #e74c3c; }
        .priority-critical { border-left: 5px solid #e67e22; }
        .priority-important { border-left: 5px solid #f39c12; }
        .priority-secondary { border-left: 5px solid #3498db; }
        .priority-final { border-left: 5px solid #2ecc71; }
        
        .tree-container {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            margin-bottom: 30px;
        }
        
        .tree {
            font-family: 'Courier New', monospace;
            line-height: 1.6;
        }
        
        .folder {
            color: #3498db;
            font-weight: bold;
        }
        
        .file {
            color: #27ae60;
        }
        
        .app-section {
            margin: 25px 0;
            padding: 20px;
            border-radius: 10px;
            background: #f8f9fa;
            border-left: 4px solid #3498db;
        }
        
        .app-title {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.3rem;
        }
        
        .tech-stack {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        
        .tech-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
        }
        
        .timeline {
            margin-top: 40px;
        }
        
        .week {
            background: white;
            margin: 15px 0;
            padding: 20px;
            border-radius: 10px;
            border-left: 5px solid #9b59b6;
        }
        
        .indent {
            margin-left: 20px;
        }
        
        .double-indent {
            margin-left: 40px;
        }
        
        .folder-icon::before {
            content: "📁 ";
        }
        
        .file-icon::before {
            content: "📄 ";
        }
        
        .priority-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
            margin-left: 10px;
            color: white;
        }
        
        .badge-urgent { background: #e74c3c; }
        .badge-critical { background: #e67e22; }
        .badge-important { background: #f39c12; }
        .badge-secondary { background: #3498db; }
        .badge-final { background: #2ecc71; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🏪 Système de Gestion de Supermarché</h1>
            <p>Arborescence Django avec Templates - Architecture Classique</p>
        </div>

        <!-- Niveaux de priorité -->
        <div class="priority-levels">
            <div class="priority-card priority-urgent">
                <h3>🔴 URGENT</h3>
                <p>Semaine 1</p>
            </div>
            <div class="priority-card priority-critical">
                <h3>🟠 CRITIQUE</h3>
                <p>Module Caisse</p>
            </div>
            <div class="priority-card priority-important">
                <h3>🟡 IMPORTANT</h3>
                <p>Semaine 2</p>
            </div>
            <div class="priority-card priority-secondary">
                <h3>🔵 SECONDAIRE</h3>
                <p>Semaine 3</p>
            </div>
            <div class="priority-card priority-final">
                <h3>🟢 FINAL</h3>
                <p>Rapports</p>
            </div>
        </div>

        <!-- Arborescence principale -->
        <div class="tree-container">
            <h2 style="color: #2c3e50; margin-bottom: 20px;">🌳 ARBORESCENCE COMPLÈTE</h2>
            
            <div class="tree">
                <div class="folder folder-icon">supermarche/</div>
                <div class="indent">
                    <div class="folder folder-icon">backend/</div>
                    <div class="indent">
                        <div class="file file-icon">manage.py</div>
                        <div class="file file-icon">requirements.txt</div>
                        
                        <!-- Project Principal -->
                        <div class="folder folder-icon">supermarche/</div>
                        <div class="indent">
                            <div class="file file-icon">__init__.py</div>
                            <div class="file file-icon">settings.py</div>
                            <div class="file file-icon">urls.py</div>
                            <div class="file file-icon">wsgi.py</div>
                            
                            <div class="folder folder-icon">templates/</div>
                            <div class="indent">
                                <div class="file file-icon">base.html</div>
                                <div class="file file-icon">header.html</div>
                                <div class="file file-icon">footer.html</div>
                                <div class="file file-icon">sidebar.html</div>
                                
                                <div class="folder folder-icon">includes/</div>
                                <div class="indent">
                                    <div class="file file-icon">messages.html</div>
                                    <div class="file file-icon">pagination.html</div>
                                    <div class="file file-icon">modal.html</div>
                                </div>
                            </div>
                        </div>

                        <!-- Applications Django -->
                        <div class="app-section">
                            <div class="app-title">📦 APPLICATIONS DJANGO</div>
                            
                            <!-- App 1 - Produits -->
                            <div class="folder folder-icon">products/ <span class="priority-badge badge-important">IMPORTANT</span></div>
                            <div class="indent">
                                <div class="file file-icon">models.py</div>
                                <div class="file file-icon">views.py</div>
                                <div class="file file-icon">urls.py</div>
                                <div class="file file-icon">admin.py</div>
                                
                                <div class="folder folder-icon">templates/products/</div>
                                <div class="indent">
                                    <div class="file file-icon">product_list.html</div>
                                    <div class="file file-icon">product_detail.html</div>
                                    <div class="file file-icon">product_form.html</div>
                                </div>
                            </div>

                            <!-- App 2 - Stocks -->
                            <div class="folder folder-icon">inventory/ <span class="priority-badge badge-important">IMPORTANT</span></div>
                            <div class="indent">
                                <div class="file file-icon">models.py</div>
                                <div class="file file-icon">views.py</div>
                                
                                <div class="folder folder-icon">templates/inventory/</div>
                                <div class="indent">
                                    <div class="file file-icon">stock_dashboard.html</div>
                                    <div class="file file-icon">stock_alerts.html</div>
                                </div>
                            </div>

                            <!-- App 3 - Fournisseurs -->
                            <div class="folder folder-icon">suppliers/ <span class="priority-badge badge-secondary">SECONDAIRE</span></div>
                            <div class="indent">
                                <div class="folder folder-icon">templates/suppliers/</div>
                                <div class="indent">
                                    <div class="file file-icon">supplier_list.html</div>
                                    <div class="file file-icon">order_form.html</div>
                                </div>
                            </div>

                            <!-- App 4 - Ventes (CRITIQUE) -->
                            <div class="folder folder-icon">sales/ <span class="priority-badge badge-critical">CRITIQUE</span></div>
                            <div class="indent">
                                <div class="folder folder-icon">templates/sales/</div>
                                <div class="indent">
                                    <div class="file file-icon">pos_interface.html</div>
                                    <div class="file file-icon">payment_processing.html</div>
                                    <div class="file file-icon">receipt_generation.html</div>
                                </div>
                            </div>

                            <!-- App 5 - Clients -->
                            <div class="folder folder-icon">customers/ <span class="priority-badge badge-secondary">SECONDAIRE</span></div>
                            <div class="indent">
                                <div class="folder folder-icon">templates/customers/</div>
                                <div class="indent">
                                    <div class="file file-icon">customer_list.html</div>
                                    <div class="file file-icon">loyalty_dashboard.html</div>
                                </div>
                            </div>

                            <!-- App 6 - Employés -->
                            <div class="folder folder-icon">employees/ <span class="priority-badge badge-secondary">SECONDAIRE</span></div>

                            <!-- App 7 - Reporting -->
                            <div class="folder folder-icon">reporting/ <span class="priority-badge badge-final">FINAL</span></div>
                            <div class="indent">
                                <div class="folder folder-icon">templates/reporting/</div>
                                <div class="indent">
                                    <div class="file file-icon">dashboard.html</div>
                                    <div class="file file-icon">sales_reports.html</div>
                                </div>
                            </div>

                            <!-- App 8 - Sécurité -->
                            <div class="folder folder-icon">security/ <span class="priority-badge badge-urgent">URGENT</span></div>
                            <div class="indent">
                                <div class="folder folder-icon">templates/security/</div>
                                <div class="indent">
                                    <div class="file file-icon">login.html</div>
                                    <div class="file file-icon">register.html</div>
                                </div>
                            </div>
                        </div>

                        <!-- Static Files -->
                        <div class="folder folder-icon">static/</div>
                        <div class="indent">
                            <div class="folder folder-icon">css/</div>
                            <div class="indent">
                                <div class="file file-icon">bootstrap.min.css</div>
                                <div class="file file-icon">style.css</div>
                                <div class="file file-icon">pos.css</div>
                            </div>
                            
                            <div class="folder folder-icon">js/</div>
                            <div class="indent">
                                <div class="file file-icon">jquery.min.js</div>
                                <div class="file file-icon">pos.js</div>
                                <div class="file file-icon">main.js</div>
                            </div>
                        </div>

                        <!-- Media Files -->
                        <div class="folder folder-icon">media/</div>
                        <div class="indent">
                            <div class="folder folder-icon">product_images/</div>
                            <div class="folder folder-icon">receipts/</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stack Technologique -->
        <div class="tech-stack">
            <div class="tech-card">
                <h3>🎯 FRONTEND</h3>
                <p>Bootstrap 5</p>
                <p>jQuery</p>
                <p>Chart.js</p>
                <p>HTML5 + CSS3</p>
            </div>
            
            <div class="tech-card">
                <h3>⚙️ BACKEND</h3>
                <p>Django 4.2</p>
                <p>PostgreSQL/SQLite</p>
                <p>Django Admin</p>
                <p>Django Forms</p>
            </div>
            
            <div class="tech-card">
                <h3>📊 FONCTIONNALITÉS</h3>
                <p>RG1-RG11 incluses</p>
                <p>Calculs automatiques</p>
                <p>Alertes stocks</p>
                <p>Rapports statistiques</p>
            </div>
        </div>

        
        </div>
    </div>
</body>
</html>